[GENERAL]
  polynomialOrder = 9
  stopAt = numSteps
  numSteps = 100
  dt = 2e-03
  timeStepper = tombo3
  checkpointControl = simulationTime
  checkpointInterval = 0.1
  scalars = temperature, 01

[FLUID PRESSURE]
  residualTol = 1e-08

[FLUID VELOCITY]
  boundaryTypeMap = inlet
  residualTol = 1e-12
  density = 1.0
  viscosity = -100

[SCALAR TEMPERATURE]
  boundaryTypeMap = inlet
  residualTol = 1e-12
  transportCoeff = 1.0
  diffusionCoeff = -100

[SCALAR 01]
  boundaryTypeMap = flux
  residualTol = 1e-12
  transportCoeff = 1.0
  diffusionCoeff = -100
