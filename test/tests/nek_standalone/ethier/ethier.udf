#include "udf.hpp"

#ifdef __okl__
@kernel void dpdx(const dlong Ntotal,
                  const double time,
                  @ restrict const dfloat *x,
                  @ restrict const dfloat *y,
                  @ restrict const dfloat *z,
                  const dlong offset,
                  @ restrict dfloat *FS)
{
  for (dlong n = 0; n < Ntotal; ++n; @tile(p_blockSize, @outer, @inner)) {
    if (n < Ntotal) {
      const dfloat xn = x[n];
      const dfloat yn = y[n];
      const dfloat zn = z[n];
      //
      const dfloat a = p_A;
      const dfloat d = p_D;
      //
      const dfloat xx = xn - p_U0 * time;
      const dfloat yy = yn - p_V0 * time;
      const dfloat zz = zn - p_W0 * time;
      //
      const dfloat exy = exp(a * (xx + yy));
      const dfloat eyz = exp(a * (yy + zz));
      const dfloat ezx = exp(a * (zz + xx));
      //
      const dfloat sxy = sin(a * xx + d * yy);
      const dfloat syz = sin(a * yy + d * zz);
      const dfloat szx = sin(a * zz + d * xx);
      //
      const dfloat cxy = cos(a * xx + d * yy);
      const dfloat cyz = cos(a * yy + d * zz);
      const dfloat czx = cos(a * zz + d * xx);
      //
      const dfloat dpdx =
          -0.5f * (a * a * exp(-2.f * d * d * p_nu * time) *
                   (2.f * a * exp(2.f * a * xx) + 2.f * a * cxy * czx * eyz + 2.f * d * czx * cyz * exy +
                    2.f * a * cxy * syz * ezx + 2.f * a * cyz * szx * exy - 2.f * a * sxy * syz * ezx -
                    2.f * d * sxy * szx * eyz));

      FS[n + offset] = -dpdx;
    }
  }
}

void exact(dfloat *u,
           dfloat *v,
           dfloat *w,
           dfloat *p,
           const dfloat x,
           const dfloat y,
           const dfloat z,
           const double t,
           const dfloat visc)
{
  const dfloat a = p_A;
  const dfloat d = p_D;

  const dfloat xx = x - p_U0 * t;
  const dfloat yy = y - p_V0 * t;
  const dfloat zz = z - p_W0 * t;

  const dfloat ex = exp(a * xx);
  const dfloat ey = exp(a * yy);
  const dfloat ez = exp(a * zz);
  const dfloat e2t = exp(-visc * d * d * t);

  const dfloat exy = exp(a * (xx + yy));
  const dfloat eyz = exp(a * (yy + zz));
  const dfloat ezx = exp(a * (zz + xx));

  const dfloat sxy = sin(a * xx + d * yy);
  const dfloat syz = sin(a * yy + d * zz);
  const dfloat szx = sin(a * zz + d * xx);

  const dfloat cxy = cos(a * xx + d * yy);
  const dfloat cyz = cos(a * yy + d * zz);
  const dfloat czx = cos(a * zz + d * xx);

  *(u) = -a * (ex * syz + ez * cxy) * e2t + p_U0;
  *(v) = -a * (ey * szx + ex * cyz) * e2t + p_V0;
  *(w) = -a * (ez * sxy + ey * czx) * e2t + p_W0;

  *(p) =
      0.5 * a * a * e2t * e2t *
      (ex * ex + 2.0 * sxy * czx * eyz + ey * ey + 2.0 * syz * cxy * ezx + ez * ez + 2.0 * szx * cyz * exy);
}

void grad_u(dfloat *grad_u_x,
            dfloat *grad_u_y,
            dfloat *grad_u_z,
            const dfloat x,
            const dfloat y,
            const dfloat z,
            const double t,
            const dfloat visc)
{
  const dfloat a = p_A;
  const dfloat d = p_D;

  const dfloat xx = x - p_U0 * t;
  const dfloat yy = y - p_V0 * t;
  const dfloat zz = z - p_W0 * t;

  const dfloat ex = exp(a * xx);
  const dfloat ey = exp(a * yy);
  const dfloat ez = exp(a * zz);
  const dfloat e2t = exp(-visc * d * d * t);

  const dfloat exy = exp(a * (xx + yy));
  const dfloat eyz = exp(a * (yy + zz));
  const dfloat ezx = exp(a * (zz + xx));

  const dfloat sxy = sin(a * xx + d * yy);
  const dfloat syz = sin(a * yy + d * zz);
  const dfloat szx = sin(a * zz + d * xx);

  const dfloat cxy = cos(a * xx + d * yy);
  const dfloat cyz = cos(a * yy + d * zz);
  const dfloat czx = cos(a * zz + d * xx);

  *(grad_u_x) = -a * ((a * ex) * syz - a * ez * sxy) * e2t;
  *(grad_u_y) = -a * (ex * (a * cyz) + ez * (-d * sxy)) * e2t;
  *(grad_u_z) = -a * (ex * (d * cyz) + (a * ez) * cxy) * e2t;
}

@kernel void exactUVWP(const dlong Ntotal,
                       const double time,
                       @ restrict const dfloat *X,
                       @ restrict const dfloat *Y,
                       @ restrict const dfloat *Z,
                       const dlong offset,
                       @ restrict dfloat *P,
                       @ restrict dfloat *U)
{
  for (dlong n = 0; n < Ntotal; ++n; @tile(p_blockSize, @outer, @inner)) {
    if (n < Ntotal) {
      dfloat u, v, w, p;
      const dfloat x = X[n];
      const dfloat y = Y[n];
      const dfloat z = Z[n];
      exact(&u, &v, &w, &p, x, y, z, time, p_nu);
      U[n + 0 * offset] = u;
      U[n + 1 * offset] = v;
      U[n + 2 * offset] = w;
      P[n] = p;
    }
  }
}

void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    dfloat u, v, w, p;
    exact(&u, &v, &w, &p, bc->x, bc->y, bc->z, bc->time, p_nu);
    bc->uxFluid = u;
    bc->uyFluid = v;
    bc->uzFluid = w;
  } else if (isField("scalar temperature")) {
    dfloat u, v, w, p;
    exact(&u, &v, &w, &p, bc->x, bc->y, bc->z, bc->time, p_nu);
    bc->sScalar = u;
  }
}

void udfNeumann(bcData *bc)
{
  if (isField("scalar temperature")) {
    dfloat grad_u_x, grad_u_y, grad_u_z;
    grad_u(&grad_u_x, &grad_u_y, &grad_u_z, bc->x, bc->y, bc->z, bc->time, p_nu);
    bc->fluxScalar = p_nu * (grad_u_x * bc->nx + grad_u_y * bc->ny + grad_u_z * bc->nz);
  }
}

#endif

void userq(double time)
{
  auto mesh = nrs->meshV;
  auto &scalar = nrs->scalar;
  const dlong Nlocal = mesh->Nelements * mesh->Np;

  dpdx(Nlocal, time, mesh->o_x, mesh->o_y, mesh->o_z, 0 * scalar->fieldOffset(), scalar->o_EXT);
  dpdx(Nlocal, time, mesh->o_x, mesh->o_y, mesh->o_z, 1 * scalar->fieldOffset(), scalar->o_EXT);
}

void UDF_LoadKernels(occa::properties &kernelInfo)
{
  setupAide &options = platform->options;

  dfloat mue, rho;
  options.getArgs("VISCOSITY", mue);
  options.getArgs("DENSITY", rho);
  kernelInfo["defines/p_nu"] = mue / rho;
  kernelInfo["defines/p_U0"] = 0.5;
  kernelInfo["defines/p_V0"] = 0.1;
  kernelInfo["defines/p_W0"] = 0.2;
  kernelInfo["defines/p_A"] = 0.025 * M_PI;
  kernelInfo["defines/p_D"] = 0.5 * M_PI;
  kernelInfo["defines/p_amp"] = 1.5;
  kernelInfo["defines/p_omega"] = 15.0;
  kernelInfo["defines/p_pi"] = M_PI;
}

void UDF_Setup()
{
  nrs->userSource = &userq;
}

void UDF_ExecuteStep(double time, int tstep)
{
  auto mesh = nrs->meshV;
  auto &scalar = nrs->scalar;

  if (tstep <= 5) {
    exactUVWP(mesh->Nlocal, time, mesh->o_x, mesh->o_y, mesh->o_z, nrs->fieldOffset, nrs->fluid->o_P, nrs->fluid->o_U);
    removeMean(nrs->fluid->ellipticSolverP, nrs->fluid->o_P);
    scalar->o_S.copyFrom(nrs->fluid->o_U, mesh->Nlocal, 0 * scalar->fieldOffset());
    scalar->o_S.copyFrom(nrs->fluid->o_U, mesh->Nlocal, 1 * scalar->fieldOffset());
  }
}
